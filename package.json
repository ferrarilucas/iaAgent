{
  "name": "ia-agent",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "start:agent": "pnpm --filter @ia/db db:migrate && pnpm --filter @ia/agent start",
    "start:web": "pnpm --filter @ia/web start"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
